{
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "ultracite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://docs.ultracite.ai/mcp"],
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
