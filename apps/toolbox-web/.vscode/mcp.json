{
  "servers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "ultracite": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://docs.ultracite.ai/mcp"]
    },
    "vite-plus": {
      "command": "npx",
      "args": ["vp", "mcp"],
      "type": "stdio"
    }
  }
}
