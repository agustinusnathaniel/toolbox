# Analytics (Umami — optional, needed only for production analytics)
# VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Set to 'true' to enable analytics debug logging
# VITE_ANALYTICS_DEBUG=false

# Set to 'true' to enable React Compiler (experimental)
# ENABLE_PLUGIN_REACT_COMPILER=false

# Set to 'true' to enable TanStack Router DevTools
# VITE_ENABLE_TANSTACK_DEVTOOLS=false

# API base URL (currently unused — reserved for future backend integration)
# VITE_API_BASE_URL=http://localhost:3001

# Canonical public origin used for marketing-page metadata
# VITE_PUBLIC_SITE_URL=https://toolbox.sznm.dev
