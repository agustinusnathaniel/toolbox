{
  "root": true,
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*",
      "*.config.ts",
      "*.{js,ts,json,md}",
      "!src/*.gen.ts",
      "!src/lib/components/ui/**/*",
      "!src/lib/styles/primitive.ts",
      "!**/*.svg",
      "!**/*.css",
      "!node_modules",
      "!.agents",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEqualsToNull": "off",
        "noLeakedRender": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useConsistentMethodSignatures": "off",
        "useConsistentTypeDefinitions": "off",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      // Test files: data-driven pure-function tests; splitting adds no clarity
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": { "maxLines": 150 }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": { "maxLines": 600, "skipBlankLines": true }
            }
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts", "*.config.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      // Justified exception: js-perf comparator page orchestrates 8+ state slices, presets, and worker lifecycle.
      // Further split would fragment the single-screen island. Narrow per-file warn 250.
      "includes": ["**/js-perf/index.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": { "maxLines": 300 }
            }
          }
        }
      }
    },
    {
      // Remaining single-screen tool pages are cohesive islands (60-130 line page components).
      // Splitting each into hooks/components would be artificial fragmentation for these smaller tools.
      // Kept as narrow per-file warn 150, not broad globs - largest tools already modularized above.
      "includes": [
        "**/csv-converter/index.tsx",
        "**/html-entities/index.tsx",
        "**/json-formatter/index.tsx",
        "**/json-to-ts/index.tsx",
        "**/jwt-decoder/index.tsx",
        "**/markdown-preview/index.tsx",
        "**/password-generator/index.tsx",
        "**/timestamp-converter/index.tsx",
        "**/ua-check/index.tsx",
        "**/url-codec/index.tsx",
        "**/uuid-generator/index.tsx",
        "**/wa-link-helper/index.tsx",
        "**/zippy-img/index.tsx",
        "**/use-zippy-img.ts",
        "**/comparator-config-bar.tsx",
        "**/homepage-page.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": { "maxLines": 150 }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/pages/**/index.tsx", "src/*.ts", "*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/routes/**/*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.d.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":URL:", ":NODE:", ":PACKAGE:"],
              ":BLANK_LINE:",
              [":ALIAS:"],
              ":BLANK_LINE:",
              [":PATH:"]
            ]
          }
        }
      }
    }
  }
}
